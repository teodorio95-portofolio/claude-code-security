{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/block_destructive.py\"",
            "statusMessage": "Checking command for destructive patterns…"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/egress_allowlist.py\"",
            "statusMessage": "Checking network egress against the allowlist…"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_scan.py\"",
            "statusMessage": "Scanning for secrets before writing…"
          }
        ]
      }
    ]
  }
}
